# Resend (envoi email formulaire contact)
# Obtenir une clé sur https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du site (utilisée pour les métadonnées et le sitemap)
NEXT_PUBLIC_SITE_URL=https://labeltechnology.mg

# Base de données Supabase (Postgres)
# URL et clé "service_role" — Project Settings > API sur supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connexion Postgres directe, utilisée uniquement par `pnpm db:migrate`
# (supabase/migrate.ts) pour appliquer supabase/migrations/*.sql.
# Project Settings > Database > Connection string (URI) sur supabase.com
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Panneau d'administration /setting
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32
