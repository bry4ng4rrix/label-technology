# --- Modèle ---
# Sans clé, Laura démarre en mode dégradé (RG-X07) : elle répond un message
# d'attente et renvoie vers le formulaire. Pratique pour développer l'UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_SECOURS=gemini-3.1-flash-lite

# --- Base ---
# PostgreSQL en production. Avec docker-compose.yml, l'hôte est « db » et
# POSTGRES_PASSWORD sert aussi à créer la base au premier démarrage.
POSTGRES_PASSWORD=change-moi-aussi
DATABASE_URL=postgresql+asyncpg://laura:change-moi-aussi@db:5432/laura
# En développement, SQLite suffit (aucun serveur à lancer) :
# DATABASE_URL=sqlite+aiosqlite:///./laura.db

# --- Sécurité (RG-X05, RG-X06) ---
ALLOWED_ORIGINS=https://labeltechnology.mg,https://www.labeltechnology.mg,http://localhost:3000
ADMIN_TOKEN=change-moi
IP_SALT=change-moi-aussi

# --- Quotas (RG-X01 à RG-X04) ---
MAX_CHARS_PAR_MESSAGE=2000
MAX_MESSAGES_PAR_CONVERSATION=30
MAX_TOKENS_SORTIE=600
TOURS_HISTORIQUE=20
MAX_MESSAGES_PAR_10S=2
MAX_CONVERSATIONS_PAR_IP_JOUR=10

# --- Notifications (RG-N02, RG-N06) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SEUIL_SCORE_CHAUD=70
SEUIL_SCORE_TIEDE=40

# --- Email (RG-R04) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_EXPEDITEUR=laura@labeltechnology.mg
EMAIL_EQUIPE=contact@labeltechnology.mg

# --- Divers ---
BASE_URL=https://laurra.duckdns.org
DELAI_ABANDON_MINUTES=30
